\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{alg:logmap-vhm}{{1}{6}{\textbf {Logarithmic Map via the Vector Heat Method (VHM)}}{algorithm.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comparison of log-maps between VHM and other methods. The VHM shows significantly sharper alignment to the reference solution, while older schemes propagate angular errors across the mesh. Because errors diffuse along the surface, even a small deviation at one region contaminates distant areas, leading to global drift.}}{7}{figure.caption.18}\protected@file@percent }
\newlabel{fig:logmap}{{2}{7}{Comparison of log-maps between VHM and other methods. The VHM shows significantly sharper alignment to the reference solution, while older schemes propagate angular errors across the mesh. Because errors diffuse along the surface, even a small deviation at one region contaminates distant areas, leading to global drift}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.3.2}Geometric centers}{7}{subsubsection.3.3.2}\protected@file@percent }
\@writefile{loa}{\contentsline {algorithm}{\numberline {2}{\ignorespaces \textbf  {Karcher Mean via VHM}}}{7}{algorithm.2}\protected@file@percent }
\newlabel{alg:karcher-mean}{{2}{7}{\textbf {Karcher Mean via VHM}}{algorithm.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Karcher mean of four green points on a surface. Methods based on local log-map approximations may fail to converge or produce biased centers, whereas the VHM-based log map guides the iterates quickly to the correct symmetric location.}}{7}{figure.caption.19}\protected@file@percent }
\newlabel{fig:karcher}{{3}{7}{Karcher mean of four green points on a surface. Methods based on local log-map approximations may fail to converge or produce biased centers, whereas the VHM-based log map guides the iterates quickly to the correct symmetric location}{figure.caption.19}{}}
