\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Boundary Conditions.} (a) Dirichlet conditions force heat loss at the edge, causing isolines to warp inwards. (b) Neumann conditions (insulated) allow heat to flow along the edge, preserving the correct geodesic distance.}}{10}{figure.caption.27}\protected@file@percent }
\newlabel{fig:boundaries}{{5}{10}{\textbf {Boundary Conditions.} (a) Dirichlet conditions force heat loss at the edge, causing isolines to warp inwards. (b) Neumann conditions (insulated) allow heat to flow along the edge, preserving the correct geodesic distance}{figure.caption.27}{}}
