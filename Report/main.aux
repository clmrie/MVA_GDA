\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comparison of Heat Method, Fast Marching, and Exact Polyhedral distance (from Crane et al., 2013). Max error is percentage of mesh diameter; Mean is relative error per vertex. Speedup factors (in parentheses) indicate how many times faster each Heat Method solve is compared to Fast Marching.}}{9}{table.caption.20}\protected@file@percent }
\newlabel{tab:method_comparison}{{1}{9}{Comparison of Heat Method, Fast Marching, and Exact Polyhedral distance (from Crane et al., 2013). Max error is percentage of mesh diameter; Mean is relative error per vertex. Speedup factors (in parentheses) indicate how many times faster each Heat Method solve is compared to Fast Marching}{table.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Robustness to noise.} The Heat Method remains numerically stable even on highly distorted meshes. At moderate noise levels, distances remain accurate; at extreme noise, the method still produces valid (if geometrically altered) results.}}{9}{figure.caption.23}\protected@file@percent }
\newlabel{fig:robustness}{{4}{9}{\textbf {Robustness to noise.} The Heat Method remains numerically stable even on highly distorted meshes. At moderate noise levels, distances remain accurate; at extreme noise, the method still produces valid (if geometrically altered) results}{figure.caption.23}{}}
